{
  "schema_version": 2,
  "experiment_id": "easy_bot_v0",
  "objective": "Use goal-conditioned competency pretraining to initialize one goal-independent policy, then measure full-match play against one fixed Easy bot.",
  "model_dir": "train/models/easy_bot_v0",
  "game_setup": {
    "player_legend": "Wu Shang",
    "opponent_legend": "Mordex",
    "opponent_difficulty": "easy",
    "map": "Small Brawlhaven",
    "mode": "training_mode",
    "resolution": [
      1920,
      1080
    ],
    "opponent_pool_size": 1
  },
  "perception": {
    "detector": "assets/yolo/best.engine",
    "yolo_infer_every_n_steps": 1,
    "weapon_classifier_enabled": false,
    "weapon_classifier_checkpoint": "train/models/weapon_classifier_r18.pt",
    "weapon_classifier_interval": 4,
    "weapon_classifier_min_confidence": 0.7,
    "weapon_classifier_cv_accuracy": 0.957
  },
  "pipeline": {
    "stage_order": [
      "recovery_bc",
      "weapon_collect",
      "weapon_bc",
      "weapon_ppo",
      "weapon_retention",
      "spacing_collect",
      "spacing_bc",
      "spacing_ppo",
      "spacing_retention",
      "combat_collect",
      "combat_bc",
      "combat_ppo",
      "combat_retention"
    ],
    "collect_phases": [
      "weapon_acquisition",
      "spacing_neutral",
      "combat_execution"
    ],
    "recovery": {
      "mode": "bc_only_existing_archive",
      "archive": "train/models/recollected/recovery_mastery_demos.npz",
      "reason": "The heuristic becomes meaningful only after the setup has put the player offstage; do not spend a live collection stage repeating that setup."
    },
    "required_checkpoints": [
      {
        "name": "movement_base",
        "path": "train/models/easy_bot_v0/llc_movement_fluency.zip",
        "role": "goal_conditioned_skill",
        "observation_dim": 168,
        "action_dim": 27
      },
      {
        "name": "recovery_bc_handoff",
        "path": "train/models/easy_bot_v0/llc_recovery_mastery_bc_init.zip",
        "role": "goal_conditioned_skill",
        "observation_dim": 168,
        "action_dim": 27
      },
      {
        "name": "weapon_bc_handoff",
        "path": "train/models/easy_bot_v0/llc_weapon_acquisition_bc_init.zip",
        "role": "goal_conditioned_skill",
        "observation_dim": 168,
        "action_dim": 27
      },
      {
        "name": "preserved_weapon_ppo",
        "path": "train/models/easy_bot_v0/llc_weapon_acquisition.zip",
        "role": "goal_conditioned_skill",
        "observation_dim": 168,
        "action_dim": 27
      }
    ],
    "deferred_checkpoint_outputs": [
      "train/models/easy_bot_v0/llc_all_skills_llc.zip"
    ],
    "demo_archives": [
      {
        "phase": "movement_fluency",
        "path": "train/models/recollected/movement_fluency_demos.npz",
        "min_samples": 100
      },
      {
        "phase": "recovery_mastery",
        "path": "train/models/recollected/recovery_mastery_demos.npz",
        "min_samples": 100
      },
      {
        "phase": "weapon_acquisition",
        "path": "train/models/recollected/weapon_acquisition_demos.npz",
        "min_samples": 100
      },
      {
        "phase": "spacing_neutral",
        "path": "train/models/recollected/spacing_neutral_demos.npz",
        "min_samples": 100
      },
      {
        "phase": "combat_execution",
        "path": "train/models/recollected/combat_execution_demos.npz",
        "min_samples": 100
      }
    ]
  },
  "skill_pretraining": {
    "goal_conditioning": true,
    "goal_families": [
      "movement",
      "weapon_acquisition",
      "spacing",
      "combat",
      "recovery"
    ],
    "goal_error": "active_mask_mass_normalized",
    "dense_reward": "goal_progress",
    "phase_order": [
      "movement_fluency",
      "weapon_acquisition",
      "spacing_neutral",
      "combat_execution",
      "recovery_mastery",
      "all_skills_llc"
    ],
    "active_pilot_phases": [
      "movement_fluency",
      "weapon_acquisition",
      "spacing_neutral",
      "combat_execution"
    ],
    "initialization": {
      "movement_checkpoint": "train/models/easy_bot_v0/llc_movement_fluency.zip",
      "device": "cpu",
      "later_phase_bc_epochs": 8,
      "bc_batch_size": 512,
      "bc_learning_rate": 0.0002,
      "bc_entropy_coef": 0.001,
      "goal_relabel": true
    },
    "ppo_pilot": {
      "timesteps_per_phase": 4096,
      "n_steps": 512,
      "batch_size": 256,
      "max_episode_steps": 200,
      "seed": 42,
      "device": "cpu",
      "periodic_eval_enabled": false,
      "sequential_eval_episodes": 2
    }
  },
  "final_agent": {
    "checkpoint_dir": "train/models/easy_bot_v0/final_agent",
    "init_from_skill_checkpoint": "train/models/easy_bot_v0/llc_all_skills_llc.zip",
    "goal_conditioning": false,
    "objective": "match",
    "observation_dim": 146,
    "action_encoding": "discrete27",
    "action_dim": 27,
    "device": "cpu",
    "n_steps": 512,
    "batch_size": 256,
    "max_episode_steps": 3000,
    "seed": 42
  },
  "final_evaluation": {
    "smoke_matches": 3,
    "diagnostic_matches": 10,
    "benchmark_matches": 30,
    "stocks_to_win": 1,
    "smoke_max_steps": 1200,
    "benchmark_max_steps": 3000,
    "deterministic": true,
    "promotion": {
      "minimum_wins": 18,
      "minimum_mean_damage_trade": 0.0,
      "maximum_self_destruct_rate": 0.2
    }
  },
  "deferred": {
    "recovery_training": true,
    "all_skills_consolidation": true,
    "weapon_classifier_integration": true,
    "opponent_pool_expansion": true
  }
}
