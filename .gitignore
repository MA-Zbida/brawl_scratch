# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
# The generic "env/" rule above would hide the package folder.
!brawl/env/

# Tool caches
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Project outputs (large, machine-specific) ---
# runs/: every training run, diagnostic and scratch output (runs/legacy/<era>/ for pre-hypothesis work).
# data/: datasets, demos, world replay and frozen input models (weapon classifier, ...).
/runs/
/data/
/work/
wandb/
logs/
*.log

# TensorRT engines are machine-specific: a plan is tied to the GPU architecture,
# driver and TensorRT version that built it, so a committed .engine is unusable to
# anyone else (and routinely exceeds GitHub's 100MB file limit). Build locally from
# the .pt -- see docs/setup.md.
*.engine

# Downloaded/exported result archives
*.zip
